<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="600" fill="#f8fafc"/>
  <rect x="20" y="20" width="760" height="560" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="720" height="60" fill="#8b5cf6" rx="8"/>
  <text x="60" y="75" font-family="Arial, sans-serif" font-size="20" fill="white" font-weight="bold">Weather Analytics Dashboard</text>
  
  <!-- Metrics Cards -->
  <rect x="60" y="120" width="150" height="80" fill="#ddd6fe" rx="8"/>
  <text x="70" y="140" font-family="Arial, sans-serif" font-size="12" fill="#5b21b6" font-weight="bold">Temperature</text>
  <text x="70" y="170" font-family="Arial, sans-serif" font-size="24" fill="#5b21b6" font-weight="bold">24°C</text>
  <text x="70" y="185" font-family="Arial, sans-serif" font-size="10" fill="#7c3aed">+2°C from yesterday</text>
  
  <rect x="230" y="120" width="150" height="80" fill="#fed7d7" rx="8"/>
  <text x="240" y="140" font-family="Arial, sans-serif" font-size="12" fill="#c53030" font-weight="bold">Humidity</text>
  <text x="240" y="170" font-family="Arial, sans-serif" font-size="24" fill="#c53030" font-weight="bold">65%</text>
  <text x="240" y="185" font-family="Arial, sans-serif" font-size="10" fill="#e53e3e">-5% from yesterday</text>
  
  <rect x="400" y="120" width="150" height="80" fill="#c6f6d5" rx="8"/>
  <text x="410" y="140" font-family="Arial, sans-serif" font-size="12" fill="#2f855a" font-weight="bold">Wind Speed</text>
  <text x="410" y="170" font-family="Arial, sans-serif" font-size="24" fill="#2f855a" font-weight="bold">12 km/h</text>
  <text x="410" y="185" font-family="Arial, sans-serif" font-size="10" fill="#38a169">+3 km/h from yesterday</text>
  
  <rect x="570" y="120" width="150" height="80" fill="#bee3f8" rx="8"/>
  <text x="580" y="140" font-family="Arial, sans-serif" font-size="12" fill="#2b6cb0" font-weight="bold">Pressure</text>
  <text x="580" y="170" font-family="Arial, sans-serif" font-size="24" fill="#2b6cb0" font-weight="bold">1013 hPa</text>
  <text x="580" y="185" font-family="Arial, sans-serif" font-size="10" fill="#3182ce">Normal</text>
  
  <!-- Chart Area -->
  <rect x="60" y="220" width="660" height="250" fill="#fafafa" stroke="#e2e8f0" rx="8"/>
  <text x="70" y="240" font-family="Arial, sans-serif" font-size="14" fill="#1a202c" font-weight="bold">Temperature Trend (Last 7 Days)</text>
  
  <!-- Simple line chart representation -->
  <polyline points="80,400 140,380 200,420 260,360 320,390 380,350 440,370 500,340 560,360 620,330 680,350" 
            fill="none" stroke="#8b5cf6" stroke-width="3"/>
  
  <!-- Chart dots -->
  <circle cx="80" cy="400" r="4" fill="#8b5cf6"/>
  <circle cx="140" cy="380" r="4" fill="#8b5cf6"/>
  <circle cx="200" cy="420" r="4" fill="#8b5cf6"/>
  <circle cx="260" cy="360" r="4" fill="#8b5cf6"/>
  <circle cx="320" cy="390" r="4" fill="#8b5cf6"/>
  <circle cx="380" cy="350" r="4" fill="#8b5cf6"/>
  <circle cx="440" cy="370" r="4" fill="#8b5cf6"/>
  <circle cx="500" cy="340" r="4" fill="#8b5cf6"/>
  <circle cx="560" cy="360" r="4" fill="#8b5cf6"/>
  <circle cx="620" cy="330" r="4" fill="#8b5cf6"/>
  <circle cx="680" cy="350" r="4" fill="#8b5cf6"/>
  
  <!-- Chart labels -->
  <text x="80" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Mon</text>
  <text x="200" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Tue</text>
  <text x="320" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Wed</text>
  <text x="440" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Thu</text>
  <text x="560" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Fri</text>
  <text x="680" y="455" font-family="Arial, sans-serif" font-size="10" fill="#64748b" text-anchor="middle">Sat</text>
  
  <!-- Footer -->
  <rect x="40" y="490" width="720" height="40" fill="#4c1d95" rx="4"/>
  <text x="400" y="513" font-family="Arial, sans-serif" font-size="12" fill="white" text-anchor="middle">Powered by Weather API | Last updated: 2 minutes ago</text>
</svg>