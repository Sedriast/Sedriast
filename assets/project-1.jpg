<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="600" fill="#f8fafc"/>
  <rect x="20" y="20" width="760" height="560" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="720" height="80" fill="#3b82f6" rx="8"/>
  <text x="60" y="85" font-family="Arial, sans-serif" font-size="24" fill="white" font-weight="bold">E-Commerce Platform</text>
  
  <!-- Navigation -->
  <rect x="40" y="140" width="720" height="40" fill="#64748b" rx="4"/>
  <text x="60" y="163" font-family="Arial, sans-serif" font-size="14" fill="white">Home | Products | Cart | Account</text>
  
  <!-- Product Grid -->
  <rect x="60" y="200" width="150" height="120" fill="#e2e8f0" rx="4"/>
  <rect x="230" y="200" width="150" height="120" fill="#e2e8f0" rx="4"/>
  <rect x="400" y="200" width="150" height="120" fill="#e2e8f0" rx="4"/>
  <rect x="570" y="200" width="150" height="120" fill="#e2e8f0" rx="4"/>
  
  <text x="135" y="265" font-family="Arial, sans-serif" font-size="12" fill="#64748b" text-anchor="middle">Product 1</text>
  <text x="305" y="265" font-family="Arial, sans-serif" font-size="12" fill="#64748b" text-anchor="middle">Product 2</text>
  <text x="475" y="265" font-family="Arial, sans-serif" font-size="12" fill="#64748b" text-anchor="middle">Product 3</text>
  <text x="645" y="265" font-family="Arial, sans-serif" font-size="12" fill="#64748b" text-anchor="middle">Product 4</text>
  
  <!-- Footer -->
  <rect x="40" y="520" width="720" height="40" fill="#1e293b" rx="4"/>
  <text x="400" y="543" font-family="Arial, sans-serif" font-size="12" fill="white" text-anchor="middle">© 2024 E-Commerce Platform</text>
</svg>